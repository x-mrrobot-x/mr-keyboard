<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#73000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#f71a222d"
                android:endColor="#f710151d" />
            <stroke android:width="1dp" android:color="#ff2b3b52" />
            <corners android:radius="12dp" />
            <padding
                android:left="17dp"
                android:top="13dp"
                android:right="17dp"
                android:bottom="16dp" />
        </shape>
    </item>
</layer-list>
