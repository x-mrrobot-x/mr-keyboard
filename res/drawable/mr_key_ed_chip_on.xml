<?xml version="1.0" encoding="utf-8"?>
<!-- Key editor: chip of the type that is selected (solid accent, white bold text) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/mr_ripple_dark">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_ui_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#ff000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
