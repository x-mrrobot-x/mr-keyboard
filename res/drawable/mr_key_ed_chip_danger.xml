<?xml version="1.0" encoding="utf-8"?>
<!-- Key editor: "delete" chip of the actions row: soft red surface with its border; dimmed when there is no key
     to delete -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_ui_faint" />
            <stroke android:width="1dp" android:color="@color/mr_ui_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/mr_ripple">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/mr_ui_danger_soft" />
                    <stroke android:width="1dp" android:color="@color/mr_ui_danger_line" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="#ff000000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
