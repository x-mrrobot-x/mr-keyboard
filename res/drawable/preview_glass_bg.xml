<?xml version="1.0" encoding="utf-8"?>
<!-- Cobalt Glass: the preview bubble. The slab of the popup with the lit rim of a key under the finger. The padding goes on the
     LAST shape: a layer-list shrinks every later layer by the padding of the ones before it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_preview_shadow" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/mr_glass_preview_top" android:endColor="@color/mr_glass_preview_bottom" />
            <stroke android:width="1dp" android:color="@color/mr_glass_preview_stroke" />
            <corners android:radius="10dp" />
            <padding android:left="19dp" android:top="10dp" android:right="18dp" android:bottom="17dp" />
        </shape>
    </item>
</layer-list>
