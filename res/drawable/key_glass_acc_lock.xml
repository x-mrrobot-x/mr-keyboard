<?xml version="1.0" encoding="utf-8"?>
<!-- Cobalt Glass: locked: the same, with a red rim. One shape: KeyStyle gives it the key radius. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_glass_key_acc_lock_fill" />
            <stroke android:width="1.5dp" android:color="@color/mr_glass_key_acc_lock_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
