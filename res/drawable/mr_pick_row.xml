<?xml version="1.0" encoding="utf-8"?>
<!-- Special-key picker: one key of the catalog (raised surface, soft border, ripple) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/mr_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_ui_raised" />
            <stroke android:width="1dp" android:color="@color/mr_ui_stroke_strong" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#ff000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
