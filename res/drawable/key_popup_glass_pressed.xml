<?xml version="1.0" encoding="utf-8"?>
<!-- Cobalt Glass: the variant under the finger, a lit pane inside the popup. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_glass_popup_key_fill" />
            <stroke android:width="1dp" android:color="@color/mr_glass_popup_key_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
