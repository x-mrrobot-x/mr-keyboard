<?xml version="1.0" encoding="utf-8"?>
<!-- Cobalt Glass: a letter key: a pane of cobalt glass, flat, with a hairline rim of the same cobalt. One shape: KeyStyle gives it the key radius. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_glass_key_normal_fill" />
            <stroke android:width="1dp" android:color="@color/mr_glass_key_normal_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
