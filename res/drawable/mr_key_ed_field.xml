<?xml version="1.0" encoding="utf-8"?>
<!-- Key editor: field of the dialog (label, committed text, Tasker command): sunken surface, the border lights up
     with the accent while the field has the focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_ui_sunken" />
            <stroke android:width="1.5dp" android:color="@color/mr_ui_cyan_line" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_ui_sunken" />
            <stroke android:width="1dp" android:color="@color/mr_ui_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
