<?xml version="1.0" encoding="utf-8"?>
<!-- Cobalt Glass: the popup of variants. A slab of deep cobalt glass with a rim of the light cobalt over a soft shadow; it is a window of its own,
     with no blur behind it, so it is denser than the keys. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_popup_shadow" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/mr_glass_popup_bg_top" android:endColor="@color/mr_glass_popup_bg_bottom" />
            <stroke android:width="1dp" android:color="@color/mr_glass_popup_bg_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
