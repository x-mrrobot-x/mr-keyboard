<?xml version="1.0" encoding="utf-8"?>
<!-- Sheet editor: secondary pills ("Rows", "Name/Badge"): raised surface with the soft accent border -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/mr_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_ui_raised" />
            <stroke android:width="1dp" android:color="@color/mr_ui_cyan_line" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#ff000000" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</ripple>
