<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#f5f8f9fa" />
            <stroke android:width="1dp" android:color="#ff686868" />
            <corners android:radius="10dp" />
            <padding
                android:left="17dp"
                android:top="10dp"
                android:right="17dp"
                android:bottom="16dp" />
        </shape>
    </item>
</layer-list>
