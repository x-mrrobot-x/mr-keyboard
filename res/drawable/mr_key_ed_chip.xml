<?xml version="1.0" encoding="utf-8"?>
<!-- Key editor: chip of the dialog (type, actions) when it is not selected: raised surface with the soft accent
     border; dimmed when the action is not possible -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/mr_ui_faint" />
            <stroke android:width="1dp" android:color="@color/mr_ui_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/mr_ripple">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/mr_ui_raised" />
                    <stroke android:width="1dp" android:color="@color/mr_ui_cyan_line" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="#ff000000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
