<?xml version="1.0" encoding="utf-8"?>
<!-- Special-key picker: content of the "Custom key code" dialog — the explanation and the field of the integer code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="12dp"
    android:paddingRight="20dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/mr_ui_text2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mr_pick_custom_prompt" />
    <EditText
        android:tag="code_field"
        android:textSize="15sp"
        android:textColor="@color/mr_ui_text"
        android:textColorHint="@color/mr_ui_text3"
        android:inputType="numberSigned"
        android:singleLine="true"
        android:background="@drawable/mr_key_ed_field"
        android:paddingLeft="14dp"
        android:paddingTop="11dp"
        android:paddingRight="14dp"
        android:paddingBottom="11dp"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
