<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/mr_ui_bg"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/main_linear1"
        android:paddingLeft="16.0dip"
        android:paddingTop="20.0dip"
        android:paddingRight="16.0dip"
        android:paddingBottom="56.0dip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/mr_ui_hero_bg"
            android:padding="16.0dip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="44.0dip"
                android:layout_height="44.0dip"
                android:src="@drawable/mr_ui_logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/english_ime_name" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14.0dip"
                android:layout_weight="1.0">
                <TextView
                    android:textSize="27.0sp"
                    android:textColor="@color/mr_ui_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/english_ime_name" />
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="@color/mr_ui_text2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:text="@string/mr_main_tagline" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/mr_ui_card_ripple"
            android:padding="16.0dip"
            android:clickable="true"
            android:focusable="true"
            android:id="@id/main_setup_btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip"
            android:minHeight="72.0dip">
            <ImageView
                android:layout_width="42.0dip"
                android:layout_height="42.0dip"
                android:src="@drawable/mr_ui_ic_gear_cyan"
                android:scaleType="fitCenter" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14.0dip"
                android:layout_weight="1.0">
                <TextView
                    android:textSize="16.0sp"
                    android:textColor="@color/mr_ui_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_setup_settings" />
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="@color/mr_ui_text2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:text="@string/mr_ui_settings_desc" />
            </LinearLayout>
            <ImageView
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:layout_marginLeft="8.0dip"
                android:src="@drawable/mr_ui_ic_chevron" />
        </LinearLayout>
        <TextView
            android:textAppearance="@style/MrUiSection"
            android:paddingLeft="4.0dip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30.0dip"
            android:text="@string/mr_section_setup" />
        <FrameLayout
            android:background="@drawable/mr_ui_primary_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16.0dip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72.0dip"
                android:importantForAccessibility="noHideDescendants">
                <TextView
                    android:textSize="15.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/mr_text_on_accent"
                    android:gravity="center"
                    android:background="@drawable/mr_ui_badge_on_accent"
                    android:layout_width="36.0dip"
                    android:layout_height="36.0dip"
                    android:text="1" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14.0dip"
                    android:layout_weight="1.0">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16.0sp"
                            android:textColor="@color/mr_text_on_accent"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_setup_configure_imes" />
                    </LinearLayout>
                    <TextView
                        android:textSize="13.0sp"
                        android:textColor="@color/mr_ui_on_accent_dim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/mr_ui_step1_desc" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:layout_marginLeft="8.0dip"
                    android:src="@drawable/mr_ui_ic_chevron_dark" />
            </LinearLayout>
            <Button
                style="@style/MrUiOverlay"
                android:background="@drawable/mr_ui_ripple_on_accent"
                android:id="@id/main_setup_btn_configure_imes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/main_setup_configure_imes" />
        </FrameLayout>
        <FrameLayout
            android:background="@drawable/mr_ui_card_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16.0dip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72.0dip"
                android:importantForAccessibility="noHideDescendants">
                <TextView
                    android:textSize="15.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/mr_accent"
                    android:gravity="center"
                    android:background="@drawable/mr_ui_badge_bg"
                    android:layout_width="36.0dip"
                    android:layout_height="36.0dip"
                    android:text="2" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14.0dip"
                    android:layout_weight="1.0">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16.0sp"
                            android:textColor="@color/mr_ui_text"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_setup_set_ime" />
                    </LinearLayout>
                    <TextView
                        android:textSize="13.0sp"
                        android:textColor="@color/mr_ui_text2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/mr_ui_step2_desc" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:layout_marginLeft="8.0dip"
                    android:src="@drawable/mr_ui_ic_chevron" />
            </LinearLayout>
            <Button
                style="@style/MrUiOverlay"
                android:background="@drawable/mr_ui_ripple_card"
                android:id="@id/main_setup_btn_set_ime"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/main_setup_set_ime" />
        </FrameLayout>
        <FrameLayout
            android:background="@drawable/mr_ui_card_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16.0dip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72.0dip"
                android:importantForAccessibility="noHideDescendants">
                <TextView
                    android:textSize="15.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/mr_accent"
                    android:gravity="center"
                    android:background="@drawable/mr_ui_badge_bg"
                    android:layout_width="36.0dip"
                    android:layout_height="36.0dip"
                    android:text="3" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14.0dip"
                    android:layout_weight="1.0">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16.0sp"
                            android:textColor="@color/mr_ui_text"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_setup_input_lang" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@color/mr_accent"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/mr_ui_pill_bg"
                    android:paddingLeft="9.0dip"
                    android:paddingTop="2.0dip"
                    android:paddingRight="9.0dip"
                    android:paddingBottom="2.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.0dip"
                    android:text="@string/mr_ui_optional" />
                    </LinearLayout>
                    <TextView
                        android:textSize="13.0sp"
                        android:textColor="@color/mr_ui_text2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/mr_ui_step3_desc" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:layout_marginLeft="8.0dip"
                    android:src="@drawable/mr_ui_ic_chevron" />
            </LinearLayout>
            <Button
                style="@style/MrUiOverlay"
                android:background="@drawable/mr_ui_ripple_card"
                android:id="@id/main_setup_btn_input_lang"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/main_setup_input_lang" />
        </FrameLayout>
        <TextView
            android:textAppearance="@style/MrUiSection"
            android:paddingLeft="4.0dip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30.0dip"
            android:text="@string/mr_section_test" />
        <EditText
            android:textSize="15.0sp"
            android:textColor="@color/mr_ui_text"
            android:textColorHint="@color/mr_ui_text3"
            android:gravity="center_vertical"
            android:background="@drawable/mr_ui_edit_bg"
            android:padding="16.0dip"
            android:drawableLeft="@drawable/mr_ui_ic_keyboard_hint"
            android:drawablePadding="12.0dip"
            android:id="@id/main_setup_edit_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:minHeight="56.0dip"
            android:hint="@string/height_preview_hint" />
        <TextView
            android:textAppearance="@style/MrUiSection"
            android:paddingLeft="4.0dip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30.0dip"
            android:text="@string/mr_section_guide" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@color/mr_ui_text2"
            android:textColorLink="@color/mr_accent"
            android:background="@drawable/mr_ui_card_shape"
            android:padding="18.0dip"
            android:id="@id/main_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:lineSpacingExtra="3.0dip" />
    </LinearLayout>
</ScrollView>
