<?xml version="1.0" encoding="utf-8"?>
<!-- Popup editor: one row of the list of action keys — the label of the key, the short description of its action and
     the buttons to move it up/down and to remove it. The row opens the key editor. Enabled states and texts that come
     from the key are set by PopupEditDialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/mr_pop_ed_row"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:tag="item_label"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/mr_ui_cyan"
        android:gravity="center"
        android:background="@drawable/mr_pop_ed_label"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <TextView
        android:tag="item_desc"
        android:textSize="12sp"
        android:textColor="@color/mr_ui_text2"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingLeft="10dp"
        android:paddingRight="6dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />
    <TextView
        android:tag="item_up"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/mr_pop_ed_icon_text"
        android:gravity="center"
        android:background="@drawable/mr_pop_ed_icon"
        android:paddingLeft="8dp"
        android:paddingTop="5dp"
        android:paddingRight="8dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="↑" />
    <TextView
        android:tag="item_down"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/mr_pop_ed_icon_text"
        android:gravity="center"
        android:background="@drawable/mr_pop_ed_icon"
        android:paddingLeft="8dp"
        android:paddingTop="5dp"
        android:paddingRight="8dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="↓" />
    <TextView
        android:tag="item_delete"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/mr_pop_ed_icon_danger_text"
        android:gravity="center"
        android:background="@drawable/mr_pop_ed_icon_danger"
        android:paddingLeft="8dp"
        android:paddingTop="5dp"
        android:paddingRight="8dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✕" />
</LinearLayout>
