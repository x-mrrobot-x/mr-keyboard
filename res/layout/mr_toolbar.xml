<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:tag="bar_main"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="fill_parent"
        android:layout_height="48dp">
        <!-- Ferramentas (padrao). A tecla da barra alterna com as sugestoes (MrSugg). -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:tag="bar_tools"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="b_clip"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:contentDescription="Clipboard"
                android:drawableLeft="@drawable/ic_mr_clip" />
            <TextView
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="b_trans"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:contentDescription="Traduzir"
                android:drawableLeft="@drawable/ic_mr_trans" />
            <TextView
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="b_shots"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:contentDescription="Anexos"
                android:drawableLeft="@drawable/ic_mr_attach" />
            <TextView
                android:textSize="12sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="b_emote"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:contentDescription="Emotes"
                android:drawableLeft="@drawable/ic_mr_emote" />
            <TextView
                android:textSize="12sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="b_sheets"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:contentDescription="Folhas do teclado"
                android:drawableLeft="@drawable/ic_mr_sheets" />
            <TextView
                android:textSize="12sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="b_tune"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:contentDescription="Personalizar teclado"
                android:drawableLeft="@drawable/ic_mr_tune" />
        </LinearLayout>
        <!-- Sugestoes de palavras (MrSugg): faixa CandidateView, com margem lateral. -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:tag="bar_sugg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1">
            <FrameLayout
                android:tag="sg_host"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:tag="bar_t"
        android:visibility="gone"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="fill_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#ffdddddd"
            android:gravity="center"
            android:tag="t_back"
            android:background="@drawable/mr_tb_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:drawableLeft="@drawable/ic_mr_back" />
        <EditText
            android:textSize="14sp"
            android:textColor="#ffdddddd"
            android:textColorHint="#99dddddd"
            android:gravity="center_vertical"
            android:tag="t_field"
            android:background="@drawable/mr_tb_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:minHeight="36dp"
            android:singleLine="true"
            android:hint="@string/mr_tr_hint"
            android:inputType="textCapSentences" />
        <TextView
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#ffdddddd"
            android:gravity="center"
            android:tag="t_lang"
            android:background="@drawable/mr_tb_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:drawableLeft="@drawable/ic_mr_globe"
            android:drawablePadding="6dp"
            android:text="AUTO → EN" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:tag="bar_c"
        android:visibility="gone"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="fill_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#ffdddddd"
            android:gravity="center"
            android:tag="clip_back"
            android:background="@drawable/mr_tb_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:drawableLeft="@drawable/ic_mr_back" />
        <TextView
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#ffdddddd"
            android:gravity="center_vertical"
            android:tag="clip_count"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#ffdddddd"
            android:gravity="center"
            android:tag="clip_sw"
            android:background="@drawable/mr_tb_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:drawableLeft="@drawable/ic_mr_rec"
            android:drawablePadding="6dp"
            android:text="Gravando" />
        <TextView
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#ffdddddd"
            android:gravity="center"
            android:tag="clip_view"
            android:background="@drawable/mr_tb_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:drawableLeft="@drawable/ic_mr_view" />
        <TextView
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#ffdddddd"
            android:gravity="center"
            android:tag="clip_clear"
            android:background="@drawable/mr_tb_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:drawableLeft="@drawable/ic_mr_trash"
            android:drawablePadding="6dp"
            android:text="Limpar" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:tag="p_clip"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="200dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="6dp">
        <TextView
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#99dddddd"
            android:tag="clip_hint"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="2dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Toque para inserir  ·  Segure para apagar" />
        <GridView
            android:tag="l_clip"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:cacheColorHint="#00000000"
            android:listSelector="@android:color/transparent"
            android:overScrollMode="never"
            android:numColumns="1"
            android:stretchMode="columnWidth"
            android:horizontalSpacing="6dp"
            android:verticalSpacing="6dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#99dddddd"
            android:gravity="center"
            android:tag="clip_empty"
            android:visibility="gone"
            android:padding="12dp"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_mr_clip_lg"
            android:drawablePadding="8dp"
            android:text="Nada copiado ainda\nO que você copiar aparece aqui" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:tag="bar_s"
        android:visibility="gone"
        android:divider="@drawable/mr_tb_gap"
        android:showDividers="middle"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="fill_parent"
        android:layout_height="48dp">
        <TextView
            style="@style/MrShotBtn"
            android:tag="shot_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:contentDescription="Voltar"
            android:drawableLeft="@drawable/ic_mr_back" />
        <com.mrkeyboard.app.MrCenteredIconButton
            style="@style/MrShotBtn"
            android:tag="shot_photos"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textSize="0sp"
            android:includeFontPadding="false"
            android:drawablePadding="0dp"
            android:layout_height="36dp"
            android:contentDescription="Fotos"
            android:drawableTop="@drawable/ic_mr_shots_c" />
        <com.mrkeyboard.app.MrCenteredIconButton
            style="@style/MrShotBtn"
            android:tag="shot_videos"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textSize="0sp"
            android:includeFontPadding="false"
            android:drawablePadding="0dp"
            android:layout_height="36dp"
            android:contentDescription="Vídeos"
            android:drawableTop="@drawable/ic_mr_video_c" />
        <com.mrkeyboard.app.MrCenteredIconButton
            style="@style/MrShotBtn"
            android:tag="shot_files"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textSize="0sp"
            android:includeFontPadding="false"
            android:drawablePadding="0dp"
            android:layout_height="36dp"
            android:contentDescription="Arquivos"
            android:drawableTop="@drawable/ic_mr_file_c" />
        <TextView
            style="@style/MrShotBtn"
            android:tag="shot_refresh"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:contentDescription="Atualizar"
            android:drawableLeft="@drawable/ic_mr_refresh" />
        <TextView
            style="@style/MrShotBtn"
            android:tag="shot_clear_cache"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Cache"
            android:contentDescription="Limpar caches de anexos"
            android:tooltipText="Limpar"
            android:drawablePadding="4dp"
            android:drawableLeft="@drawable/ic_mr_cache" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:tag="p_shots"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="200dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="6dp">
        <GridView
            android:tag="g_shots"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:cacheColorHint="#00000000"
            android:listSelector="@android:color/transparent"
            android:overScrollMode="never"
            android:numColumns="4"
            android:stretchMode="columnWidth"
            android:horizontalSpacing="6dp"
            android:verticalSpacing="6dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#99dddddd"
            android:gravity="center"
            android:tag="shot_empty"
            android:visibility="gone"
            android:padding="12dp"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_mr_shots_lg"
            android:drawablePadding="8dp"
            android:text="Carregando…" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:tag="bar_e"
        android:visibility="gone"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="fill_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#ffdddddd"
            android:gravity="center"
            android:tag="emote_back"
            android:background="@drawable/mr_tb_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:drawableLeft="@drawable/ic_mr_back" />
        <HorizontalScrollView
            android:scrollbars="none"
            android:overScrollMode="never"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent">
            <TextView
                android:textSize="18sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="cat_r"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:contentDescription="Recentes"
                android:drawableLeft="@drawable/ic_mr_cat_r" />
            <TextView
                android:textSize="18sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="cat_0"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:contentDescription="Carinhas e pessoas"
                android:drawableLeft="@drawable/ic_mr_cat_0" />
            <TextView
                android:textSize="18sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="cat_1"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:contentDescription="Animais e natureza"
                android:drawableLeft="@drawable/ic_mr_cat_1" />
            <TextView
                android:textSize="18sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="cat_2"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:contentDescription="Comida e bebida"
                android:drawableLeft="@drawable/ic_mr_cat_2" />
            <TextView
                android:textSize="18sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="cat_3"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:contentDescription="Atividades"
                android:drawableLeft="@drawable/ic_mr_cat_3" />
            <TextView
                android:textSize="18sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="cat_4"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:contentDescription="Viagens e lugares"
                android:drawableLeft="@drawable/ic_mr_cat_4" />
            <TextView
                android:textSize="18sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="cat_5"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:contentDescription="Objetos"
                android:drawableLeft="@drawable/ic_mr_cat_5" />
            <TextView
                android:textSize="18sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="cat_6"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:contentDescription="Símbolos"
                android:drawableLeft="@drawable/ic_mr_cat_6" />
            <TextView
                android:textSize="18sp"
                android:textColor="#ffdddddd"
                android:gravity="center"
                android:tag="cat_7"
                android:background="@drawable/mr_tb_btn"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:contentDescription="Bandeiras"
                android:drawableLeft="@drawable/ic_mr_cat_7" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:tag="p_emote"
        android:visibility="gone"
