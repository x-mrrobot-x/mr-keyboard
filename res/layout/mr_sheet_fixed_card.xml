<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/mr_sheet_fixed_bg"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="@color/mr_ui_text2"
        android:gravity="center"
        android:background="@drawable/mr_sheet_chip_bg"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:text="@string/mr_sheets_abc" />
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/mr_ui_text"
            android:fontFamily="sans-serif-medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mr_sheets_main_title" />
        <TextView
            android:textSize="12sp"
            android:textColor="@color/mr_ui_text3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mr_sheets_main_desc" />
    </LinearLayout>
    <ImageView
        android:tag="lock"
        android:layout_width="24dp"
        android:layout_height="24dp" />
</LinearLayout>
