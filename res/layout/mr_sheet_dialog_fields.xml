<?xml version="1.0" encoding="utf-8"?>
<!-- Name and badge of a sheet (SheetNameDialog: new sheet, and "Name and badge" on the list and in the editor).
     The two fields are made by SheetUi.makeEditText and added by the code in the slots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="12dp"
    android:paddingRight="20dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="@color/mr_ui_text2"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mr_sheets_name_label" />
    <LinearLayout
        android:tag="name_slot"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <TextView
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="@color/mr_ui_text2"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mr_sheets_badge_label" />
    <LinearLayout
        android:tag="badge_slot"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <TextView
        android:textSize="12sp"
        android:textColor="@color/mr_ui_text3"
        android:paddingLeft="2dp"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mr_sheets_badge_note" />
</LinearLayout>
