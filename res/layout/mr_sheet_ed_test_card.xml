<?xml version="1.0" encoding="utf-8"?>
<!-- Sheet editor: "quick test" card. The field changes to the *_on drawables while it has the focus (the code
     switches them, like the old screen did), and the "Clear" chip only shows up when there is text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="test_card"
    android:orientation="vertical"
    android:background="@drawable/mr_sheet_ed_card_bg"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/mr_ui_cyan"
            android:letterSpacing="0.06"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mr_sheet_ed_test_title" />
        <TextView
            android:tag="test_badge"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="@color/mr_ui_cyan"
            android:background="@drawable/mr_sheet_ed_live_bg"
            android:paddingLeft="8dp"
            android:paddingTop="2.5dp"
            android:paddingRight="8dp"
            android:paddingBottom="2.5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <LinearLayout
            android:tag="test_clear"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/mr_sheet_ed_clear_bg"
            android:paddingLeft="9dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:visibility="gone">
            <ImageView
                android:tag="test_clear_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginRight="4dp" />
            <TextView
                android:textSize="11.5sp"
                android:textColor="@color/mr_ui_text2"
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mr_sheet_ed_test_clear" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:tag="test_field_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/mr_sheet_ed_field_bg"
        android:minHeight="54dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <ImageView
            android:tag="test_field_icon"
            android:scaleType="center"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="10dp" />
        <EditText
            android:tag="test_input"
            android:background="@null"
            android:textSize="15sp"
            android:textColor="@color/mr_ui_text"
            android:textColorHint="@color/mr_ui_text3"
            android:hint="@string/mr_sheet_ed_test_hint"
            android:paddingLeft="0dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="12dp"
            android:maxLines="4"
            android:inputType="textMultiLine|textNoSuggestions"
            android:imeOptions="flagNoExtractUi|flagNoFullscreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
    <TextView
        android:textSize="11.5sp"
        android:textColor="@color/mr_ui_text3"
        android:paddingLeft="2dp"
        android:paddingTop="8dp"
        android:paddingRight="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mr_sheet_ed_test_footer" />
</LinearLayout>
