<?xml version="1.0" encoding="utf-8"?>
<!-- "New version available" dialog (MrUpdateDialog), in the fixed theme of the settings screens (Theme.MrKeyboard.Dialog).
     The views are found by tag. upd_box and upd_error are hidden: the download and the install use them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="20dp"
    android:paddingRight="22dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:tag="upd_title"
        android:text="@string/mr_update_title"
        android:textSize="19sp"
        android:textColor="@color/mr_ui_text"
        android:fontFamily="sans-serif-medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:tag="upd_sub"
        android:textSize="13sp"
        android:textColor="@color/mr_ui_text2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <View
        android:background="@color/mr_ui_stroke"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp" />

    <ScrollView
        android:tag="upd_scroll"
        android:scrollbars="vertical"
        android:overScrollMode="never"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp">
        <TextView
            android:tag="upd_notes"
            android:textSize="14sp"
            android:textColor="@color/mr_ui_text"
            android:lineSpacingExtra="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <LinearLayout
        android:tag="upd_box"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">
        <TextView
            android:tag="upd_status"
            android:textSize="14sp"
            android:textColor="@color/mr_ui_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <ProgressBar
            android:tag="upd_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <TextView
        android:tag="upd_error"
        android:textSize="13sp"
        android:textColor="@color/mr_ui_rose"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" />

    <TextView
        android:tag="upd_install"
        android:text="@string/mr_update_install"
        android:textSize="15sp"
        android:textColor="@color/mr_text_on_accent"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:background="@drawable/mr_ui_primary_shape"
        android:foreground="@drawable/mr_ui_ripple_on_accent"
        android:clickable="true"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <TextView
        android:tag="upd_github"
        android:text="@string/mr_update_github"
        android:textSize="14sp"
        android:textColor="@color/mr_ui_text"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:background="@drawable/mr_ui_card_ripple"
        android:clickable="true"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:tag="upd_later"
        android:text="@string/mr_update_later"
        android:textSize="14sp"
        android:textColor="@color/mr_ui_text2"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:background="@drawable/mr_ui_card_ripple"
        android:clickable="true"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp" />
</LinearLayout>
