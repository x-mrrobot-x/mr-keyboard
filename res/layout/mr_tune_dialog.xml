<?xml version="1.0" encoding="utf-8"?>
<!-- "Preferences" dialog of the toolbar: same look as the height dialog of the settings.
     The root is the dark layer (only the area above the keyboard); the card is centered in it.
     The tags sk_*/vl_*/tl_* are the same ones used by MrTune. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#b8000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/mr_tune_dialog_bg"
        android:clickable="true"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginRight="16.0dip"
        android:layout_marginBottom="10.0dip">
        <TextView
            android:textSize="18.0sp"
            android:textColor="@color/mr_ui_text"
            android:fontFamily="sans-serif-medium"
            android:paddingLeft="20.0dip"
            android:paddingTop="16.0dip"
            android:paddingRight="20.0dip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/mr_tb_customize" />
        <ScrollView
            android:overScrollMode="never"
            android:layout_width="match_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="10.0dip"
                android:paddingTop="4.0dip"
                android:paddingRight="20.0dip"
                android:paddingBottom="2.0dip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="@color/mr_ui_text2"
                    android:fontFamily="sans-serif-medium"
                    android:tag="tl_h"
                    android:paddingLeft="10.0dip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/mr_tune_v" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <SeekBar
                        android:tag="sk_h"
                        android:paddingStart="10dp"
                        android:paddingLeft="10dp"
                        android:paddingTop="6.0dip"
                        android:paddingBottom="6.0dip"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                    <TextView
                        android:textSize="13.0sp"
                        android:textColor="@color/mr_accent"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/mr_ui_value_pill"
                        android:tag="vl_h"
                        android:paddingLeft="8.0dip"
                        android:paddingTop="2.0dip"
                        android:paddingRight="8.0dip"
                        android:paddingBottom="2.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4.0dip"
                        android:minWidth="56.0dip"
                        android:singleLine="true"
                        android:text="33%" />
                </LinearLayout>
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="@color/mr_ui_text2"
                    android:fontFamily="sans-serif-medium"
                    android:tag="tl_b"
                    android:paddingLeft="10.0dip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/title_bar_scale" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <SeekBar
                        android:tag="sk_b"
                        android:paddingStart="10dp"
                        android:paddingLeft="10dp"
                        android:paddingTop="6.0dip"
                        android:paddingBottom="6.0dip"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                    <TextView
                        android:textSize="13.0sp"
                        android:textColor="@color/mr_accent"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/mr_ui_value_pill"
                        android:tag="vl_b"
                        android:paddingLeft="8.0dip"
                        android:paddingTop="2.0dip"
                        android:paddingRight="8.0dip"
                        android:paddingBottom="2.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4.0dip"
                        android:minWidth="56.0dip"
                        android:singleLine="true"
                        android:text="100%" />
                </LinearLayout>
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="@color/mr_ui_text2"
                    android:fontFamily="sans-serif-medium"
                    android:tag="tl_l"
                    android:paddingLeft="10.0dip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/title_label_scale" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <SeekBar
                        android:tag="sk_l"
                        android:paddingStart="10dp"
                        android:paddingLeft="10dp"
                        android:paddingTop="6.0dip"
                        android:paddingBottom="6.0dip"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                    <TextView
                        android:textSize="13.0sp"
                        android:textColor="@color/mr_accent"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/mr_ui_value_pill"
                        android:tag="vl_l"
                        android:paddingLeft="8.0dip"
                        android:paddingTop="2.0dip"
                        android:paddingRight="8.0dip"
                        android:paddingBottom="2.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4.0dip"
                        android:minWidth="56.0dip"
                        android:singleLine="true"
                        android:text="100%" />
                </LinearLayout>
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="@color/mr_ui_text2"
                    android:fontFamily="sans-serif-medium"
                    android:tag="tl_s"
                    android:paddingLeft="10.0dip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/title_key_spacing" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <SeekBar
                        android:tag="sk_s"
                        android:paddingStart="10dp"
                        android:paddingLeft="10dp"
                        android:paddingTop="6.0dip"
                        android:paddingBottom="6.0dip"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                    <TextView
                        android:textSize="13.0sp"
                        android:textColor="@color/mr_accent"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/mr_ui_value_pill"
                        android:tag="vl_s"
                        android:paddingLeft="8.0dip"
                        android:paddingTop="2.0dip"
                        android:paddingRight="8.0dip"
                        android:paddingBottom="2.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4.0dip"
                        android:minWidth="56.0dip"
                        android:singleLine="true"
                        android:text="4 dp" />
                </LinearLayout>
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="@color/mr_ui_text2"
                    android:fontFamily="sans-serif-medium"
                    android:tag="tl_r"
                    android:paddingLeft="10.0dip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/mr_tb_radius" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <SeekBar
                        android:tag="sk_r"
                        android:paddingStart="10dp"
                        android:paddingLeft="10dp"
                        android:paddingTop="6.0dip"
                        android:paddingBottom="6.0dip"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                    <TextView
                        android:textSize="13.0sp"
                        android:textColor="@color/mr_accent"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/mr_ui_value_pill"
                        android:tag="vl_r"
                        android:paddingLeft="8.0dip"
                        android:paddingTop="2.0dip"
                        android:paddingRight="8.0dip"
                        android:paddingBottom="2.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4.0dip"
                        android:minWidth="56.0dip"
                        android:singleLine="true"
                        android:text="8 dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:gravity="center_vertical"
            android:paddingLeft="8.0dip"
            android:paddingTop="2.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="6.0dip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="13.0sp"
                android:textColor="@color/mr_accent"
                android:tag="tune_reset"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mr_tune_reset" />
            <View
                android:layout_width="0.0dip"
                android:layout_height="1.0dip"
                android:layout_weight="1.0" />
            <Button
                android:textSize="13.0sp"
                android:textColor="@color/mr_accent"
                android:tag="tune_ok"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mr_tune_close" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
