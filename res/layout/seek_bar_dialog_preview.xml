<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="24.0dip"
    android:paddingTop="14.0dip"
    android:paddingRight="24.0dip"
    android:paddingBottom="8.0dip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="30.0sp"
        android:textColor="@color/mr_accent"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/mr_ui_value_pill"
        android:paddingLeft="24.0dip"
        android:paddingTop="8.0dip"
        android:paddingRight="24.0dip"
        android:paddingBottom="8.0dip"
        android:layout_gravity="center_horizontal"
        android:id="@id/seekVal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="120.0dip"
        android:text="@string/seek_pref_val" />
    <SeekBar
        android:id="@id/seekBarPref"
        android:paddingTop="20.0dip"
        android:paddingBottom="8.0dip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16.0dip"
        android:paddingRight="16.0dip">
        <TextView
            android:textSize="12.0sp"
            android:textColor="@color/mr_ui_text3"
            android:id="@id/seekMin"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/seek_pref_0"
            android:layout_weight="1.0" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="@color/mr_ui_text3"
            android:gravity="right"
            android:id="@id/seekMax"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/seek_pref_max"
            android:layout_weight="1.0" />
    </LinearLayout>
    <EditText
        android:textSize="15.0sp"
        android:textColor="@color/mr_ui_text"
        android:textColorHint="@color/mr_ui_text3"
        android:background="@drawable/mr_ui_edit_bg"
        android:padding="14.0dip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18.0dip"
        android:hint="@string/height_preview_hint"
        android:singleLine="true"
        android:inputType="text"
        android:imeOptions="flagNoExtractUi|flagNoFullscreen">
        <requestFocus />
    </EditText>
</LinearLayout>
