<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/mr_ui_card_ripple"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="6dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">
    <TextView
        android:tag="badge"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="@color/mr_ui_cyan"
        android:gravity="center"
        android:background="@drawable/mr_sheet_badge_bg"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp" />
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:tag="name"
            android:textSize="15.5sp"
            android:textColor="@color/mr_ui_text"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:tag="info"
            android:textSize="12sp"
            android:textColor="@color/mr_ui_text2"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <ImageView
        android:tag="up"
        android:scaleType="center"
        android:background="@drawable/mr_sheet_icon_ripple"
        android:layout_width="34dp"
        android:layout_height="36dp" />
    <ImageView
        android:tag="down"
        android:scaleType="center"
        android:background="@drawable/mr_sheet_icon_ripple"
        android:layout_width="34dp"
        android:layout_height="36dp" />
    <ImageView
        android:tag="more"
        android:scaleType="center"
        android:background="@drawable/mr_sheet_icon_ripple"
        android:layout_width="36dp"
        android:layout_height="36dp" />
</LinearLayout>
