<?xml version="1.0" encoding="utf-8"?>
<!-- Registry of the keyboard themes. The index of mr_theme_layouts is the value stored in the preference
     pref_keyboard_layout (the same positions as keyboard_layout_modes_values, plus the old values 1 to 6,
     which open Slate). New theme: create res/layout/input_mr_<theme>.xml with the tag mr_<theme>, one line in
     mr_theme_layouts, one line in mr_theme_tags and another in mr_theme_flags (same position), the name in
     keyboard_layout_modes and the value in keyboard_layout_modes_values. The radius of each key layer needs
     no registry: KeyStyle adds to the key radius the slack that the drawable itself draws. -->
<resources>
    <!-- Layout of each theme (KeyboardSwitcher) -->
    <array name="mr_theme_layouts">
        <item>@layout/input_mr_neon</item>
        <item>@layout/input_mr_slate</item>
        <item>@layout/input_mr_slate</item>
        <item>@layout/input_mr_slate</item>
        <item>@layout/input_mr_slate</item>
        <item>@layout/input_mr_slate</item>
        <item>@layout/input_mr_slate</item>
        <item>@layout/input_mr_soft</item>
        <item>@layout/input_mr_slate</item>
        <item>@layout/input_mr_midnight</item>
        <item>@layout/input_mr_glass</item>
    </array>
    <!-- Tag of each theme layout (android:tag of LatinKeyboardView) -->
    <string-array name="mr_theme_tags">
        <item>mr_neon</item>
        <item>mr_soft</item>
        <item>mr_slate</item>
        <item>mr_midnight</item>
        <item>mr_glass</item>
    </string-array>
    <!-- Flags of each tag, in the same order as mr_theme_tags (the bits are at the top of MrTheme.smali):
         0x02 flat bar, 0x04 highlight keys, 0x08 enlarged highlight group, 0x10 translucent,
         0x20 tech palette, 0x40 default text on the highlight keys -->
    <integer-array name="mr_theme_flags">
        <item>0x0c</item>
        <item>0x0c</item>
        <item>0x6c</item>
        <item>0x6e</item>
        <item>0x7e</item>
    </integer-array>
</resources>
