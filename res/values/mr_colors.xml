    <color name="mr_glass_modifier_indicator_lock">#ffff6b6b</color>

    <color name="mr_alpha_press">#59000000</color>
    <!-- Pressed tool button of the bar (b_*, cat_*): the Ctrl face (ctrl_bg) at this opacity. The default is for the dark faces
         (Slate, Midnight); Neon, Soft and Glass, whose faces are brighter, declare a lower one to stay subtle. -->
    <color name="mr_alpha_flat">#b3000000</color>
    <color name="mr_neon_alpha_flat">#4d000000</color>
    <color name="mr_soft_alpha_flat">#59000000</color>
    <color name="mr_glass_alpha_flat">#59000000</color>
    <!-- Fill of the buttons inside the tools (back, language, attachments, clear...), in EVERY theme: the Ctrl accent at this
         opacity, no border (MrTools.softBg); on touch, alpha_press. #00000000 = fully transparent buttons. The same opacity
         paints the border of the translation field (MrTools.fieldBg). -->
    <color name="mr_alpha_btn">#29000000</color>
    <!-- Tabs that are not selected (Attachments): the Ctrl accent at this opacity (MrTools.tabOffBg), below alpha_btn. -->
    <color name="mr_alpha_tab_off">#14000000</color>
    <color name="mr_alpha_sel">#47000000</color>
    <color name="mr_alpha_card">#22000000</color>
    <!-- Attachments: picker button (attach_fab), selection Cancel/Send (sel_cancel, sel_send) and item marking.
         Roles *_stroke: 1 dp border; *_text and attach_fab_icon: text and icon. sel_send also paints the check of the marked item
         (background sel_send, ring sel_send_stroke, stroke sel_send_text). sel_media: layer over the marked thumbnail;
         sel_card: background of the marked file. Values below: Midnight; the other themes declare their own version. -->
    <color name="mr_sel_cancel">#ff263344</color>
    <color name="mr_sel_cancel_stroke">#ff324357</color>
    <color name="mr_sel_cancel_text">#ffcfdbea</color>
