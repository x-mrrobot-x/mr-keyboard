    <!-- Surfaces -->
    <color name="mr_slate_kbd_bg">#ff0a0e14</color>
    <color name="mr_soft_kbd_bg">#ff00020e</color>
    <color name="mr_neon_kbd_bg">#ff09110c</color>
    <!-- Keyboard background of the Midnight Steel theme -->
    <color name="mr_midnight_kbd_bg">#ff171e27</color>
    <color name="mr_glass_kbd_bg">#80090f17</color>
    <color name="mr_glass_kbd_bg_blur">#17090f17</color>

    <!-- Text and icon of the highlight keys (MrTheme.color, role accent_text). Only applies to themes without the
         PLAIN_ACCENT_TEXT flag (Neon and Soft); with the flag the theme uses the default key text. Default: white; Neon
         uses dark text on the green. -->
    <color name="mr_accent_text">#ffffffff</color>
    <color name="mr_neon_accent_text">#ff07130c</color>

    <!-- ===== Toolbar and panel colors (MrTheme.color) =====
         Looked up by name: first mr_<theme>_<role> (e.g. mr_glass_panel_btn), then mr_<role>.
         The mr_panel_* values are the usual ones (Slate, Midnight, Neon, Soft); a theme that needs
         another color only declares its own mr_<theme>_panel_* version.
         Background: the toolbar and the panels have no color of their own in any theme; they show the keyboard's (kbd_bg).
         The buttons of the bar do NOT use panel_* colors: their colors come from the Ctrl key (highlight keys) of the theme,
         through the roles ctrl_bg and alpha_* below. -->
    <!-- Only the file card of the Attachments panel in the flat themes (MrTools.cardBg). -->
    <color name="mr_panel_btn">#ff263344</color>
    <!-- Translation text field: transparent background. The border is NOT a fixed color: MrTools.fieldBg paints it
         with the theme color (accent) at the opacity of mr_alpha_btn, the same as the buttons next to it. -->
    <color name="mr_panel_field">#00000000</color>
    <color name="mr_panel_card">#33888888</color>
    <color name="mr_panel_icon">#ffdfe7f1</color>
    <color name="mr_panel_tab_on_text">@color/mr_panel_icon</color>
    <color name="mr_panel_tab_off_text">#ff9db1c8</color>
    <!-- Face of the Ctrl key (highlight keys) of each theme: the only source of the toolbar colors. Each theme points at the
         color of its own highlight key in mr_key_colors.xml, so changing the key changes the bar. MrTools.ctrlBg() reads it as it
         is (pressed tool button); MrTools.deriveColors() lightens it into the accent (inner buttons, field border). Default:
         Midnight Steel. -->
    <color name="mr_ctrl_bg">@color/mr_midnight_key_hl_fill</color>
    <color name="mr_neon_ctrl_bg">@color/mr_neon_key_acc_normal_base</color>
    <color name="mr_soft_ctrl_bg">@color/mr_soft_key_acc_normal_top</color>
    <color name="mr_slate_ctrl_bg">@color/mr_slate_key_hl_top</color>
    <color name="mr_midnight_ctrl_bg">@color/mr_midnight_key_hl_fill</color>
    <color name="mr_glass_ctrl_bg">@color/mr_glass_key_acc_normal_fill</color>

    <!-- Shared interaction hues: pressed-key edge, selected popup subkey edge and key-preview outline. -->
    <color name="mr_press_accent">#ff72a6ef</color>
    <color name="mr_neon_press_accent">#ff71e89d</color>
    <color name="mr_soft_press_accent">#ff70a5ff</color>
    <color name="mr_slate_press_accent">#ff75a7ef</color>
    <color name="mr_midnight_press_accent">#ff72a2e8</color>
    <color name="mr_glass_press_accent">#bb8fb8e8</color>
    <!-- Lower dash of Ctrl, Alt, Shift and the Meta key (❖). These keys wear the theme's highlight face and the dash tells their
         state, so the colors are chosen against that face and every one belongs to the theme's own hue: off is a subdued tone of
         the face (Slate, Midnight and Glass about 1.3 of contrast, Neon and Soft a little more), on is the theme's interaction
         color (Neon uses a light green, because its press green is too close to the green face) and locked is red. -->
    <color name="mr_modifier_indicator_off">#ff263446</color>
    <color name="mr_modifier_indicator_on">@color/mr_press_accent</color>
    <color name="mr_modifier_indicator_lock">#ffff5252</color>

    <color name="mr_neon_modifier_indicator_off">#ff2a9d59</color>
    <color name="mr_neon_modifier_indicator_on">#ffb6f5cc</color>
    <color name="mr_neon_modifier_indicator_lock">#ffc62828</color>

    <color name="mr_soft_modifier_indicator_off">#ff062372</color>
    <color name="mr_soft_modifier_indicator_on">@color/mr_soft_press_accent</color>
    <color name="mr_soft_modifier_indicator_lock">#ffff5a5a</color>

    <color name="mr_slate_modifier_indicator_off">#ff213249</color>
    <color name="mr_slate_modifier_indicator_on">@color/mr_slate_press_accent</color>
    <color name="mr_slate_modifier_indicator_lock">#ffff5a5a</color>

    <color name="mr_midnight_modifier_indicator_off">#ff263446</color>
    <color name="mr_midnight_modifier_indicator_on">@color/mr_midnight_press_accent</color>
