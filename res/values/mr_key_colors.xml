<?xml version="1.0" encoding="utf-8"?>
<!-- Mr Keyboard · colors of the theme drawables (keys, long-press popup and preview balloon).
     The drawables only reference @color; radii and margins stay in them (KeyStyle changes the radius at run time).

     Name: mr_<theme>_key_<state>_<part>
       state  normal, pressed, on, lock; acc_<state> is the highlight key (Glass; its hl state is drawn as acc_normal).
       part   halo (outer glow), base (fill under the other layers), fill (fill),
              top / mid / bottom (gradient, from top to bottom), stroke (border), shadow (shadow).

     Neutral shadows that repeat across themes have a global name (mr_popup_shadow and mr_preview_shadow).
     The popup and preview colors that are not shadows stay in mr_colors.xml (mr_<theme>_popup_*, mr_<theme>_preview_*).
     Only Cobalt Glass is here: the colors of the generated themes (Midnight Steel, the light ones and the neon ones) are in
     mr_solid_colors.xml, mr_gloss_colors.xml and mr_neon_colors.xml, written by docs/tools/make_themes.py. -->
<resources>
    <!-- Shadows (apply to all themes) -->
    <color name="mr_popup_shadow">#80000000</color>
    <color name="mr_preview_shadow">#66000000</color>

    <!-- ===== Cobalt Glass =====
         Panes of see-through glass (the scale and the idea of the theme are in mr_colors.xml). Each state is one shape: ONE flat
         fill (a step of the cobalt with its opacity, no gradient) and a rim (stroke, 1 dp, the same hue as the fill). The more a
         key is held, the more light it has: a bluer fill and a lit rim; locked, the rim is red (1.5 dp). -->
    <!-- normal: a letter key: a flat pane of cobalt glass with a hairline rim of the same cobalt -->
    <color name="mr_glass_key_normal_fill">#5232578b</color>
    <color name="mr_glass_key_normal_stroke">#296ea0e7</color>
    <!-- pressed: under the finger: the glass lights up -->
    <color name="mr_glass_key_pressed_fill">#756ea0e7</color>
    <color name="mr_glass_key_pressed_stroke">#9991b9ec</color>
    <!-- on: a sticky key that is on: lit cobalt, with the rim lit -->
    <color name="mr_glass_key_on_fill">#852f72d9</color>
    <color name="mr_glass_key_on_stroke">#9e91b9ec</color>
    <!-- lock: locked: the same, with a red rim -->
    <color name="mr_glass_key_lock_fill">#852f72d9</color>
    <color name="mr_glass_key_lock_stroke">#d1ff7a7a</color>
    <!-- acc_normal: a highlight key: a bluer pane (also the hl state) -->
    <color name="mr_glass_key_acc_normal_fill">#703e6fb3</color>
    <color name="mr_glass_key_acc_normal_stroke">#3d91b9ec</color>
    <!-- acc_pressed: a highlight key under the finger -->
    <color name="mr_glass_key_acc_pressed_fill">#856ea0e7</color>
    <color name="mr_glass_key_acc_pressed_stroke">#a391b9ec</color>
    <!-- acc_on: a sticky highlight key that is on -->
    <color name="mr_glass_key_acc_on_fill">#9e2f72d9</color>
    <color name="mr_glass_key_acc_on_stroke">#ad91b9ec</color>
    <!-- acc_lock: locked: the same, with a red rim -->
    <color name="mr_glass_key_acc_lock_fill">#9e2f72d9</color>
    <color name="mr_glass_key_acc_lock_stroke">#d6ff7a7a</color>
</resources>
