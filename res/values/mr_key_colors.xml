<?xml version="1.0" encoding="utf-8"?>
<!-- Mr Keyboard · cores dos drawables de tema (teclas, popup do toque longo e balão de preview).
     Os drawables só referenciam @color; raios e margens continuam neles (o KeyStyle troca o raio em tempo de execução).

     Nome: mr_<tema>_key_<estado>_<parte>
       estado  normal, pressed, hl, on, lock; acc_<estado> é a tecla de destaque (Neon, Soft e Glass).
       parte   halo (brilho externo), base (preenchimento sob as demais camadas), fill (preenchimento),
               top / mid / bottom (gradiente, de cima para baixo), stroke (borda), shadow (sombra).

     Sombras neutras que se repetem entre temas têm nome global (mr_key_shadow, mr_popup_shadow e mr_preview_shadow).
     As cores de popup e preview que não são sombra ficam em mr_colors.xml (mr_<tema>_popup_*, mr_<tema>_preview_*). -->
<resources>
    <!-- Sombras (valem para todos os temas) -->
    <color name="mr_key_shadow">#73000000</color>
    <color name="mr_popup_shadow">#80000000</color>
    <color name="mr_preview_shadow">#66000000</color>

    <!-- ===== Neon =====
         Como no Slate, a tecla de destaque (acc_*) segue o hl em repouso e usa as cores de pressed, on e lock nos outros estados; só a cor base é dela. -->
    <!-- normal -->
    <color name="mr_neon_key_normal_halo">#263ddc84</color>
    <color name="mr_neon_key_normal_stroke">#d93ddc84</color>
    <!-- pressed -->
    <color name="mr_neon_key_pressed_halo">#403ddc84</color>
    <color name="mr_neon_key_pressed_fill">#403ddc84</color>
    <color name="mr_neon_key_pressed_stroke">#ff3ddc84</color>
    <!-- hl -->
    <color name="mr_neon_key_hl_halo">#263ddc84</color>
    <color name="mr_neon_key_hl_stroke">#d93ddc84</color>
    <!-- on -->
    <color name="mr_neon_key_on_halo">#303ddc84</color>
    <color name="mr_neon_key_on_fill">#2e3ddc84</color>
    <color name="mr_neon_key_on_stroke">#ff3ddc84</color>
    <!-- lock -->
    <color name="mr_neon_key_lock_halo">#4d3ddc84</color>
    <color name="mr_neon_key_lock_fill">#593ddc84</color>
    <color name="mr_neon_key_lock_stroke">#ff3ddc84</color>
    <!-- acc_normal -->
    <color name="mr_neon_key_acc_normal_base">#ff35c46f</color>
    <!-- acc_pressed -->
    <color name="mr_neon_key_acc_pressed_base">#ff23904f</color>
    <!-- acc_on -->
    <color name="mr_neon_key_acc_on_base">#ff9cf0bc</color>
    <!-- acc_lock -->
    <color name="mr_neon_key_acc_lock_base">#ff9cf0bc</color>

