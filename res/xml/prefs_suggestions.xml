<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:hk="http://schemas.android.com/apk/res-auto">
  <PreferenceCategory android:title="@string/mr_dicts_cat_langs" android:key="mr_cat_langs" android:icon="@drawable/mr_ui_ic_book_mint"/>
  <PreferenceCategory android:title="@string/mr_dicts_cat_suggestions" android:key="mr_cat_suggestions" android:icon="@drawable/mr_ui_ic_typea_violet">
    <CheckBoxPreference android:persistent="true" android:title="@string/show_suggestions" android:key="show_suggestions" android:summary="@string/show_suggestions_summary" android:defaultValue="@bool/default_suggestions"/>
    <CheckBoxPreference android:persistent="true" android:title="@string/auto_complete" android:key="auto_complete" android:summary="@string/auto_complete_summary" android:dependency="show_suggestions" android:defaultValue="@bool/enable_autocorrect"/>
    <CheckBoxPreference android:persistent="true" android:title="@string/quick_fixes" android:key="quick_fixes" android:dependency="show_suggestions" android:summary="@string/quick_fixes_summary" android:defaultValue="@bool/default_quick_fixes"/>
    <CheckBoxPreference android:persistent="true" android:title="@string/prefs_enable_recorrection" android:key="recorrection_enabled" android:dependency="show_suggestions" android:summary="@string/prefs_enable_recorrection_summary" android:defaultValue="@bool/default_recorrection_enabled"/>
    <CheckBoxPreference android:persistent="true" android:title="@string/title_suggestions_in_landscape" android:key="suggestions_in_landscape" android:dependency="show_suggestions" android:defaultValue="@bool/default_suggestions_in_landscape" android:summaryOn="@string/summary_suggestions_in_landscape_true" android:summaryOff="@string/summary_suggestions_in_landscape_false"/>
    <com.mrkeyboard.app.AutoSummaryEditTextPreference android:layout="@layout/mr_ui_pref_row_value" android:widgetLayout="@layout/mr_ui_widget_caret" android:title="@string/title_suggested_punctuation" android:key="pref_suggested_punctuation" android:dependency="show_suggestions" android:defaultValue="@string/suggested_punctuations"/>
    <com.mrkeyboard.app.SeekBarPreferenceString android:persistent="true" android:title="@string/title_candidate_scale" android:key="pref_candidate_scale" android:dependency="show_suggestions" android:defaultValue="1.0" hk:asPercent="true" hk:logScale="true" hk:maxValue="3.0" hk:minValue="0.5"/>
  </PreferenceCategory>
  <PreferenceCategory android:title="@string/mr_words_cat" android:key="mr_cat_words" android:icon="@drawable/mr_ui_ic_book_mint">
    <Preference android:key="mr_words_learned" android:title="@string/mr_learned_title" android:summary="@string/mr_learned_summary" android:persistent="false">
      <intent android:targetPackage="com.mrkeyboard.app" android:targetClass="com.mrkeyboard.app.MrLearnedActivity"/>
    </Preference>
    <Preference android:key="mr_words_import" android:title="@string/mr_import_title" android:summary="@string/mr_import_summary" android:persistent="false">
      <intent android:targetPackage="com.mrkeyboard.app" android:targetClass="com.mrkeyboard.app.MrImportActivity"/>
    </Preference>
  </PreferenceCategory>
  <PreferenceCategory android:title="@string/mr_dicts_cat_privacy" android:key="mr_cat_privacy" android:icon="@drawable/mr_ui_ic_info_slate">
    <Preference android:layout="@layout/mr_ui_pref_row_static" android:key="mr_privacy" android:title="@string/mr_dicts_privacy_title" android:summary="@string/mr_dicts_privacy_text" android:selectable="false" android:persistent="false"/>
  </PreferenceCategory>
</PreferenceScreen>
