<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:hk="http://schemas.android.com/apk/res-auto" android:title="@string/pref_screen_feedback_title" android:key="feedback_settings">
  <PreferenceCategory android:title="@string/mr_ui_cat_haptic" android:key="haptic_settings" android:icon="@drawable/mr_ui_ic_vibrate_amber">
    <CheckBoxPreference android:persistent="true" android:title="@string/vibrate_on_keypress" android:key="vibrate_on" android:defaultValue="true"/>
    <com.mrkeyboard.app.VibratePreference android:persistent="true" android:title="@string/title_vibrate_len" android:key="vibrate_len" android:defaultValue="1" hk:displayFormat="%.0f ms" hk:logScale="true" hk:maxValue="200.0" hk:minValue="1.0"/>
  </PreferenceCategory>
  <PreferenceCategory android:title="@string/mr_ui_cat_sound" android:key="sound_settings" android:icon="@drawable/mr_ui_ic_speaker_mint">
    <CheckBoxPreference android:persistent="true" android:title="@string/sound_on_keypress" android:key="sound_on"/>
    <com.mrkeyboard.app.SeekBarPreferenceString android:persistent="true" android:title="@string/title_click_volume" android:key="pref_click_volume" android:dependency="sound_on" android:defaultValue="@string/default_click_volume" hk:asPercent="true" hk:maxValue="1.0" hk:minValue="0.0" hk:step="0.05"/>
  </PreferenceCategory>
  <PreferenceCategory android:title="@string/mr_ui_cat_visual" android:key="visual_feedback_settings" android:icon="@drawable/mr_ui_ic_eye_cyan">
    <CheckBoxPreference android:persistent="true" android:title="@string/popup_on_keypress" android:key="popup_on" android:summary="@string/summary_popup_on" android:defaultValue="@bool/default_popup_preview"/>
  </PreferenceCategory>
</PreferenceScreen>
