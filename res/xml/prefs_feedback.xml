<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:hk="http://schemas.android.com/apk/res-auto" android:title="@string/pref_screen_feedback_title" android:key="feedback_settings">
  <PreferenceCategory android:title="@string/mr_ui_cat_haptic" android:key="haptic_settings" android:icon="@drawable/mr_ui_ic_vibrate_amber">
    <CheckBoxPreference android:persistent="true" android:title="@string/vibrate_on_keypress" android:key="vibrate_on" android:defaultValue="false"/>
    <CheckBoxPreference android:persistent="true" android:title="@string/mr_vibrate_system_title" android:key="vibrate_system" android:summary="@string/mr_vibrate_system_sum" android:disableDependentsState="true" android:defaultValue="true"/>
    <com.mrkeyboard.app.VibratePreference android:persistent="true" android:title="@string/title_vibrate_len" android:key="vibrate_strength" android:dependency="vibrate_system" android:defaultValue="0.5" hk:asPercent="true" hk:maxValue="1.0" hk:minValue="0.05" hk:step="0.05"/>
  </PreferenceCategory>
  <PreferenceCategory android:title="@string/mr_ui_cat_sound" android:key="sound_settings" android:icon="@drawable/mr_ui_ic_speaker_mint">
    <CheckBoxPreference android:persistent="true" android:title="@string/sound_on_keypress" android:key="sound_on" android:defaultValue="true"/>
    <Preference android:persistent="false" android:title="@string/mr_sound_title" android:key="mr_sound_style" android:summary="@string/mr_sound_summary">
      <intent android:targetPackage="com.mrkeyboard.app" android:targetClass="com.mrkeyboard.app.MrSoundActivity"/>
    </Preference>
  </PreferenceCategory>
  <PreferenceCategory android:title="@string/mr_ui_cat_visual" android:key="visual_feedback_settings" android:icon="@drawable/mr_ui_ic_eye_cyan">
    <CheckBoxPreference android:persistent="true" android:title="@string/popup_on_keypress" android:key="popup_on" android:summary="@string/summary_popup_on" android:defaultValue="@bool/default_popup_preview"/>
  </PreferenceCategory>
</PreferenceScreen>
