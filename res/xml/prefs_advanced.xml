<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:hk="http://schemas.android.com/apk/res-auto" android:title="@string/pref_screen_advanced_title" android:key="prefs_advanced">
  <PreferenceCategory android:title="@string/mr_ui_cat_codes" android:key="modifier_codes" android:summary="@string/mr_ui_cat_codes_sum" android:icon="@drawable/mr_ui_ic_terminal_rose">
    <com.mrkeyboard.app.AutoSummaryListPreference android:persistent="true" android:entries="@array/ctrl_a_override_entries" android:title="@string/title_ctrl_a_override" android:key="pref_ctrl_a_override" android:defaultValue="@string/default_ctrl_a_override" android:entryValues="@array/ctrl_a_override_values"/>
    <com.mrkeyboard.app.AutoSummaryListPreference android:persistent="true" android:entries="@array/chording_ctrl_key_entries" android:title="@string/title_chording_ctrl_key" android:key="pref_chording_ctrl_key" android:defaultValue="@string/default_chording_ctrl_key" android:entryValues="@array/chording_ctrl_key_values"/>
    <com.mrkeyboard.app.AutoSummaryListPreference android:persistent="true" android:entries="@array/chording_alt_key_entries" android:title="@string/title_chording_alt_key" android:key="pref_chording_alt_key" android:defaultValue="@string/default_chording_alt_key" android:entryValues="@array/chording_alt_key_values"/>
  </PreferenceCategory>
  <PreferenceCategory android:title="@string/mr_ui_cat_input" android:key="input_mode_settings" android:summary="@string/mr_ui_cat_input_sum" android:icon="@drawable/mr_ui_ic_monitor_violet">
    <CheckBoxPreference android:persistent="true" android:title="@string/title_fullscreen_override" android:key="fullscreen_override" android:defaultValue="@bool/default_fullscreen_override" android:summaryOn="@string/summary_fullscreen_override_true" android:summaryOff="@string/summary_fullscreen_override_false"/>
    <CheckBoxPreference android:persistent="true" android:title="@string/title_force_keyboard_on" android:key="force_keyboard_on" android:defaultValue="@bool/default_force_keyboard_on" android:summaryOn="@string/summary_force_keyboard_on_true" android:summaryOff="@string/summary_force_keyboard_on_false"/>
  </PreferenceCategory>
  <PreferenceCategory android:title="@string/mr_ui_cat_draw" android:key="screen_drawing" android:summary="@string/mr_ui_cat_draw_sum" android:icon="@drawable/mr_ui_ic_eye_cyan">
    <CheckBoxPreference android:persistent="true" android:title="@string/mr_ui_hw_accel" android:key="pref_ui_hw_accel" android:defaultValue="false" android:summaryOn="@string/mr_ui_hw_accel_on" android:summaryOff="@string/mr_ui_hw_accel_off"/>
  </PreferenceCategory>
</PreferenceScreen>
