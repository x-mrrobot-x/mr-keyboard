<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:hk="http://schemas.android.com/apk/res-auto" android:title="@string/pref_screen_view_title" android:key="prefs_view">
  <PreferenceCategory android:title="@string/mr_ui_cat_shape" android:key="shape_settings" android:icon="@drawable/mr_ui_ic_keycap_blue">
    <com.mrkeyboard.app.SeekBarPreferenceString android:persistent="true" android:title="@string/title_key_spacing" android:key="pref_key_spacing" android:defaultValue="@string/default_key_spacing" hk:displayFormat="%.0f dp" hk:maxValue="16.0" hk:minValue="0.0" hk:step="1.0"/>
    <com.mrkeyboard.app.SeekBarPreferenceString android:persistent="true" android:title="@string/title_key_radius" android:key="pref_key_radius" android:defaultValue="@string/default_key_radius" hk:displayFormat="%.0f dp" hk:maxValue="30.0" hk:minValue="0.0" hk:step="1.0"/>
  </PreferenceCategory>
  <PreferenceCategory android:title="@string/mr_ui_cat_labels" android:key="graphics_settings" android:icon="@drawable/mr_ui_ic_eye_cyan">
    <com.mrkeyboard.app.AutoSummaryListPreference android:persistent="true" android:entries="@array/hint_modes" android:title="@string/title_hint_mode" android:key="pref_hint_mode" android:defaultValue="@string/default_hint_mode" android:entryValues="@array/hint_modes_values"/>
    <com.mrkeyboard.app.SeekBarPreferenceString android:persistent="true" android:title="@string/title_label_scale" android:key="pref_label_scale_v2" android:defaultValue="0.69" hk:asPercent="true" hk:logScale="true" hk:maxValue="2.0" hk:minValue="0.5"/>
  </PreferenceCategory>
</PreferenceScreen>
