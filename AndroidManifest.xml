<?xml version="1.0" encoding="utf-8"?>
<manifest
    android:compileSdkVersion="36"
    package="com.mrkeyboard.app"
    platformBuildVersionCode="36"
    platformBuildVersionName="16"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permite que o app controle a vibração. -->
    <uses-permission
        android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.INTERNET" />
    <!-- v1.63: só para saber se a rede é Wi-Fi/sem cobrança antes de baixar um dicionário -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_USER_DICTIONARY" />
    <uses-permission
        android:name="android.permission.WRITE_USER_DICTIONARY" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <queries>
        <intent>
            <action
                android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action
                android:name="org.pocketworkstation.DICT" />
        </intent>
        <intent>
            <action
                android:name="com.menny.android.anysoftkeyboard.DICTIONARY" />
        </intent>
    </queries>
    <application
        android:name="com.mrkeyboard.app.MrApplication"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:label="@string/english_ime_name"
        android:icon="@drawable/icon"
        android:backupAgent="com.mrkeyboard.app.LatinIMEBackupAgent"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:killAfterRestore="false"
        android:restoreAnyVersion="true"
        android:hardwareAccelerated="false">
        <service
            android:label="@string/english_ime_name"
            android:name="com.mrkeyboard.app.LatinIME"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action
                    android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        <activity
            android:label="@string/english_ime_name"
            android:name="com.mrkeyboard.app.Main"
            android:exported="true"
            android:theme="@style/Theme.MrKeyboard.Main">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:label="@string/english_ime_settings"
            android:name="com.mrkeyboard.app.LatinIMESettings"
            android:exported="true"
            android:theme="@style/Theme.MrKeyboard.Settings">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <action
                    android:name="com.mrkeyboard.app.SETTINGS" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:label="@string/mr_dicts_title"
            android:name="com.mrkeyboard.app.MrPacksActivity"
            android:exported="false"
            android:theme="@style/Theme.MrKeyboard.Settings">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <action
                    android:name="com.mrkeyboard.app.PREFS_DICTS" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:label="@string/language_selection_title"
            android:name="com.mrkeyboard.app.InputLanguageSelection"
            android:exported="false"
            android:theme="@style/Theme.MrKeyboard.Settings">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <action
                    android:name="com.mrkeyboard.app.INPUT_LANGUAGE_SELECTION" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:label="@string/pref_screen_actions_title"
            android:name="com.mrkeyboard.app.PrefScreenActions"
            android:exported="false"
            android:theme="@style/Theme.MrKeyboard.Settings">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <action
                    android:name="com.mrkeyboard.app.PREFS_ACTIONS" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:label="@string/pref_screen_advanced_title"
            android:name="com.mrkeyboard.app.PrefScreenAdvanced"
            android:exported="false"
            android:theme="@style/Theme.MrKeyboard.Settings">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <action
                    android:name="com.mrkeyboard.app.PREFS_ADVANCED" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:label="@string/pref_screen_sheets_title"
            android:name="com.mrkeyboard.app.PrefScreenSheets"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.MrKeyboard.Main">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <action
                    android:name="com.mrkeyboard.app.PREFS_SHEETS" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:label="@string/pref_screen_sheets_title"
            android:name="com.mrkeyboard.app.SheetEditorActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MrKeyboard.Main" />
        <activity
            android:label="@string/pref_screen_view_title"
            android:name="com.mrkeyboard.app.PrefScreenView"
            android:exported="false"
            android:theme="@style/Theme.MrKeyboard.Settings">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <action
                    android:name="com.mrkeyboard.app.PREFS_VIEW" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:label="@string/pref_screen_feedback_title"
            android:name="com.mrkeyboard.app.PrefScreenFeedback"
            android:exported="false"
            android:theme="@style/Theme.MrKeyboard.Settings">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <action
                    android:name="com.mrkeyboard.app.PREFS_FEEDBACK" />
                <category
                    android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.google.android.voiceime.ActivityHelper"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.mrkeyboard.app.ShotPerm"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <provider
            android:name="android.support.v4.content.FileProvider"
            android:exported="false"
            android:authorities="com.mrkeyboard.app.shots"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mr_shot_paths" />
        </provider>
        <service
            android:name="com.google.android.voiceime.ServiceHelper"
            android:exported="false" />
    </application>
</manifest>